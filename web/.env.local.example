# Kopiér denne fil til .env.local til lokal test med `vercel dev`.
# I selve Vercel-projektet sættes de samme navne under Settings -> Environment Variables
# (ALDRIG i git - .env.local er allerede gitignored).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=dit-navn@dit-domæne.fo
SMTP_PASS=SÆT_APP_ADGANGSKODE_HER

FROM_NAME=Svar Kiosk

# Kommasepareret liste, fx: modtager1@eksempel.dk,modtager2@eksempel.dk
RECIPIENTS_ANONYM=modtager1@eksempel.dk
RECIPIENTS_FULL=modtager2@eksempel.dk

ADMIN_PASSWORD=SKIFT_MIG

COUNTDOWN_SECONDS=10
COUNTDOWN_TEXT=Hetta er teksturin í 10sek
MAX_CHARS=2000
